# The toolset for the claude cell. The VM around it is the boundary; this is
# replaceable tooling, and nothing here holds a credential.
#
# Nothing here is pinned. Every build takes the newest of each — the newest
# Ubuntu LTS and tmux from it, Node's newest LTS line, the latest nvm, Neovim,
# lazygit, gh and Catppuccin's tmux theme, and LazyVim with the latest of its
# plugins — so a cell is brought up to date by rebuilding it, never by editing
# this file. Each step proves its tool runs before the build moves on, so an
# upstream release that breaks one fails the build, and the image you already
# have is kept.
FROM docker.io/library/ubuntu:latest

# GitHub CLI's apt repository is signed by this key, as cli.github.com's own
# install page lists it. It is the one thing written down here: a release
# changes nothing below, and a new key is a change worth noticing, so a
# keyring without it fails the build rather than being trusted because it
# arrived over HTTPS.
ARG GH_KEY_FINGERPRINT=7F38BBB59D064DBCB3D84D725612B36462313325

ENV DEBIAN_FRONTEND=noninteractive

# Without this the image has no locale at all, and every terminal program falls
# back to ASCII: tmux rewrites each wide character as an underscore, so the
# theme's rounded pills and the agent's status marks arrive mangled. C.UTF-8 is
# built into glibc, so it needs no locale package.
ENV LANG=C.UTF-8
ENV NVM_DIR=/opt/nvm
# /opt/nvm/current is a symlink this file creates. It keeps node on PATH for
# `solitary exec`, which runs a command in a non-interactive shell where nvm's
# own shell function is never sourced.
ENV PATH=/opt/nvm/current/bin:/usr/local/bin:$PATH

# Nothing in here updates itself. The container is started over from this image
# every time the machine boots, so an update an agent downloads into it is gone
# by the next one and fetched again after it — and an update that is not in the
# image is one nobody chose. Tools are updated by rebuilding instead:
# `solitary up --rebuild`, or b in the dashboard, builds this file again without
# a cache, and everything in it comes in at its latest. gh and npm only
# announce updates, but there is nothing they could announce that the cell can
# act on.
ENV DISABLE_AUTOUPDATER=1 \
    GH_NO_UPDATE_NOTIFIER=1 \
    NPM_CONFIG_UPDATE_NOTIFIER=false

# tmux is Ubuntu's: the one in the current LTS knows every option tmux.conf
# sets, extended-keys-format included, and a config that tmux does not change
# under has nothing to gain from a newer one.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      bash-completion \
      build-essential \
      ca-certificates \
      curl \
      fd-find \
      git \
      gnupg \
      jq \
      less \
      ncurses-term \
      procps \
      ripgrep \
      tmux \
      unzip \
      xz-utils \
 && rm -rf /var/lib/apt/lists/* \
 && tmux -V

# Prints the tag of a GitHub repository's latest release; see the script.
COPY --chmod=0755 latest-tag /usr/local/bin/latest-tag

# nvm lives in /opt rather than in the home, because the cell's home is a
# directory on the machine that is mounted over /home/cell at start: anything
# this image writes under there would be hidden the moment the container runs.
# PROFILE=/dev/null keeps the installer from editing a shell rc that the seeded
# ~/.bashrc owns.
#
# Node is its newest LTS line. corepack left Node after 24, so it is installed
# from npm wherever Node no longer carries it.
RUN mkdir -p "$NVM_DIR" \
 && nvm_version="$(latest-tag https://github.com/nvm-sh/nvm)" \
 && curl -fsSL "https://raw.githubusercontent.com/nvm-sh/nvm/${nvm_version}/install.sh" \
    | PROFILE=/dev/null bash \
 && . "$NVM_DIR/nvm.sh" \
 && nvm install --lts \
 && nvm alias default 'lts/*' \
 && ln -s "$NVM_DIR/versions/node/$(nvm version default)" "$NVM_DIR/current" \
 && { command -v corepack >/dev/null || npm install -g corepack; } \
 && corepack enable \
 && node --version

# tree-sitter's CLI is what nvim-treesitter compiles parsers with. Installed
# here, it is on PATH when LazyVim looks for it below; left out, LazyVim
# installs it through Mason, and its build hook and its config both start that
# install at once — the second fails with "Package is already installing" and
# takes nvim-treesitter's setup down with it for that run.
RUN npm install -g @anthropic-ai/claude-code tree-sitter-cli \
 && claude --version \
 && tree-sitter --version

# Neovim's latest release rather than Ubuntu's. LazyVim and its plugins are
# taken at their latest below, and they move their minimum Neovim with Neovim
# itself; a Neovim held at the release an LTS shipped would be left behind by
# them at some rebuild nobody chose. Its releases publish no checksums, so HTTPS
# from GitHub is all that vouches for the archive.
RUN arch="$(uname -m)" \
 && case "$arch" in \
      x86_64)  nvim_arch=x86_64 ;; \
      aarch64) nvim_arch=arm64 ;; \
      *) echo "unsupported architecture: $arch" >&2; exit 1 ;; \
    esac \
 && tag="$(latest-tag https://github.com/neovim/neovim)" \
 && curl -fsSL -o /tmp/nvim.tar.gz \
      "https://github.com/neovim/neovim/releases/download/${tag}/nvim-linux-${nvim_arch}.tar.gz" \
 && tar -C /opt -xzf /tmp/nvim.tar.gz \
 && ln -s "/opt/nvim-linux-${nvim_arch}/bin/nvim" /usr/local/bin/nvim \
 && rm /tmp/nvim.tar.gz \
 && nvim --version | head -n 1

# lazygit drives LazyVim's <leader>gg, which is only mapped when the binary is
# there. Its latest release, verified against the checksums published beside
# the archive.
RUN arch="$(uname -m)" \
 && case "$arch" in \
      x86_64)  lg_arch=x86_64 ;; \
      aarch64) lg_arch=arm64 ;; \
      *) echo "unsupported architecture: $arch" >&2; exit 1 ;; \
    esac \
 && tag="$(latest-tag https://github.com/jesseduffield/lazygit)" \
 && version="${tag#v}" \
 && base="https://github.com/jesseduffield/lazygit/releases/download/${tag}" \
 && archive="lazygit_${version}_linux_${lg_arch}.tar.gz" \
 && curl -fsSL -o "/tmp/${archive}" "${base}/${archive}" \
 && curl -fsSL -o /tmp/lazygit.sha256 "${base}/checksums.txt" \
 && (cd /tmp && grep " ${archive}\$" lazygit.sha256 | sha256sum -c -) \
 && tar -C /tmp -xzf "/tmp/${archive}" lazygit \
 && install -m755 /tmp/lazygit /usr/local/bin/lazygit \
 && rm "/tmp/${archive}" /tmp/lazygit.sha256 /tmp/lazygit \
 && lazygit --version

# gh, so the agent can open pull requests and read issues without a browser: a
# cell cannot open one on the host, so GITHUB_TOKEN from cell.yaml is how it
# authenticates. From GitHub's own apt repository, so apt verifies every
# package against GitHub's signing key — once the keyring is shown to hold the
# key named at the top of this file.
RUN keyring=/etc/apt/keyrings/githubcli-archive-keyring.gpg \
 && mkdir -p -m 755 /etc/apt/keyrings \
 && curl -fsSL -o "$keyring" https://cli.github.com/packages/githubcli-archive-keyring.gpg \
 && chmod 644 "$keyring" \
 && if ! gpg --show-keys --with-colons "$keyring" | grep -q "^fpr:*${GH_KEY_FINGERPRINT}:"; then \
      echo "GitHub CLI's keyring no longer holds ${GH_KEY_FINGERPRINT}; check cli.github.com and update GH_KEY_FINGERPRINT" >&2; \
      exit 1; \
    fi \
 && echo "deb [arch=$(dpkg --print-architecture) signed-by=$keyring] https://cli.github.com/packages stable main" \
    > /etc/apt/sources.list.d/github-cli.list \
 && apt-get update \
 && apt-get install -y --no-install-recommends gh \
 && rm -rf /var/lib/apt/lists/* \
 && gh --version

# tmux is configured system-wide rather than seeded: /etc/tmux.conf is read
# before anything in the home, so a rebuilt image brings a new theme to a cell
# whose home is years old, and a ~/.tmux.conf still overrides it.
#
# The theme is the one plugin, and tmux.conf loads it itself: a plugin manager
# exists to fetch plugins on first run, and this one is fetched here, so a
# fresh cell has a working status bar without pressing anything. Its latest
# release rather than its main branch, so the look changes when Catppuccin
# publishes a release, not because an image was rebuilt on a different day.
RUN tag="$(latest-tag https://github.com/catppuccin/tmux)" \
 && git clone --depth 1 --branch "$tag" https://github.com/catppuccin/tmux /etc/tmux/catppuccin \
 && test -f /etc/tmux/catppuccin/catppuccin.tmux

# tmux is the quietest of them: given a config file it cannot read, it starts
# anyway with none of this applied and reports nothing.
COPY --chmod=0644 tmux.conf /etc/tmux.conf
COPY --chmod=0755 system-stats.sh /etc/tmux/system-stats.sh
# Marks the tmux window Claude Code runs in; the hooks in the seeded
# ~/.claude/settings.json call it, and tmux.conf shows the mark.
COPY --chmod=0755 agent-status /usr/local/bin/agent-status

# Everything under /opt/cell-skel is copied into the cell's home the first time
# the container starts, and only where nothing is there already.
COPY skel/ /opt/cell-skel/
COPY cell-init /usr/local/bin/cell-init
RUN chmod 755 /usr/local/bin/cell-init /opt/cell-skel/.claude/statusline-command.sh

# LazyVim, its plugins and its treesitter parsers are installed here rather than
# on first start: a build is the one place with time to spend, and it is what
# makes opening nvim in a fresh cell instant. HOME points at the skel so that
# both the config and the state it produces are seeded together.
#
# TSInstall is asynchronous and headless nvim would exit out from under it, so
# the second run waits for the parsers to appear rather than for a fixed number
# of seconds. The list above installs a few more than the 20 it waits for —
# some of its entries share a parser — and the count is checked again
# afterwards: a wait that timed out leaves nvim quitting either way, and only
# the test can tell the difference.
RUN git clone --depth 1 https://github.com/LazyVim/starter /opt/cell-skel/.config/nvim \
 && rm -rf /opt/cell-skel/.config/nvim/.git \
 && HOME=/opt/cell-skel timeout 900 nvim --headless "+Lazy! sync" +qa \
 && HOME=/opt/cell-skel timeout 900 nvim --headless \
      "+TSInstall bash c diff html javascript jsdoc json lua luadoc luap markdown markdown_inline printf python query regex toml tsx typescript vim vimdoc xml yaml" \
      "+lua vim.wait(600000, function() return #vim.fn.glob(vim.fn.stdpath('data') .. '/**/parser/*.so', true, true) >= 20 end, 2000) vim.cmd('qa!')" \
 && test "$(find /opt/cell-skel/.local/share/nvim -type f \( -name '*.so' -o -name '*-parser' \) | wc -l)" -ge 20 \
 && rm -rf /opt/cell-skel/.cache /opt/cell-skel/.local/state/nvim
