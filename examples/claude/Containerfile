# The toolset for the claude cell. The VM around it is the boundary; this is
# replaceable tooling, so everything here is installed from a pinned version and
# nothing here holds a credential.
FROM docker.io/library/ubuntu:24.04

# The versions this cell pins. Nothing else in the repository names them.
ARG NODE_VERSION=24.20.0
ARG NVM_VERSION=v0.40.7
ARG NVIM_VERSION=v0.12.5
ARG LAZYGIT_VERSION=0.64.1
ARG WORKMUX_VERSION=v0.1.247
ARG GH_VERSION=2.98.0
ARG TMUX_VERSION=3.7c
ARG CATPPUCCIN_TMUX_VERSION=v2.3.0

ENV DEBIAN_FRONTEND=noninteractive

# Without this the image has no locale at all, and every terminal program falls
# back to ASCII: tmux rewrites each wide character as an underscore, so the
# theme's rounded pills and workmux's status glyphs arrive mangled. C.UTF-8 is
# built into glibc, so it needs no locale package.
ENV LANG=C.UTF-8
ENV NVM_DIR=/opt/nvm
# /opt/nvm/current is a symlink this file creates. It keeps node on PATH for
# `solitary exec`, which runs a command in a non-interactive shell where nvm's
# own shell function is never sourced.
ENV PATH=/opt/nvm/current/bin:/usr/local/bin:$PATH

# Nothing in here updates itself. The container is started over from this image
# every time the machine boots, so an update an agent downloads into it is gone
# by the next one and fetched again after it — and an update that is not in the
# image is one nobody chose. Tools are updated by rebuilding instead:
# `solitary up --rebuild`, or b in the dashboard, builds this file again without
# a cache, so what is pinned above stays pinned and what is not comes in at its
# latest. gh and npm only announce updates, but there is nothing they could
# announce that the cell can act on.
ENV DISABLE_AUTOUPDATER=1 \
    GH_NO_UPDATE_NOTIFIER=1 \
    NPM_CONFIG_UPDATE_NOTIFIER=false

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      bash-completion \
      build-essential \
      ca-certificates \
      curl \
      fd-find \
      git \
      jq \
      less \
      ncurses-term \
      procps \
      ripgrep \
      unzip \
      xz-utils \
 && rm -rf /var/lib/apt/lists/*

# nvm lives in /opt rather than in the home, because the cell's home is a
# directory on the machine that is mounted over /home/cell at start: anything
# this image writes under there would be hidden the moment the container runs.
# PROFILE=/dev/null keeps the installer from editing a shell rc that the seeded
# ~/.bashrc owns.
RUN mkdir -p "$NVM_DIR" \
 && curl -fsSL "https://raw.githubusercontent.com/nvm-sh/nvm/${NVM_VERSION}/install.sh" \
    | PROFILE=/dev/null bash \
 && . "$NVM_DIR/nvm.sh" \
 && nvm install "$NODE_VERSION" \
 && nvm alias default "$NODE_VERSION" \
 && ln -s "$NVM_DIR/versions/node/v${NODE_VERSION}" "$NVM_DIR/current" \
 && corepack enable \
 && node --version

RUN npm install -g @anthropic-ai/claude-code \
 && claude --version

# Neovim: Ubuntu ships one far too old for LazyVim.
RUN arch="$(uname -m)" \
 && case "$arch" in \
      x86_64)  nvim_arch=x86_64 ;; \
      aarch64) nvim_arch=arm64 ;; \
      *) echo "unsupported architecture: $arch" >&2; exit 1 ;; \
    esac \
 && curl -fsSL -o /tmp/nvim.tar.gz \
      "https://github.com/neovim/neovim/releases/download/${NVIM_VERSION}/nvim-linux-${nvim_arch}.tar.gz" \
 && tar -C /opt -xzf /tmp/nvim.tar.gz \
 && ln -s "/opt/nvim-linux-${nvim_arch}/bin/nvim" /usr/local/bin/nvim \
 && rm /tmp/nvim.tar.gz \
 && nvim --version | head -n 1

# lazygit drives LazyVim's <leader>gg, which is only mapped when the binary is
# there.
RUN arch="$(uname -m)" \
 && case "$arch" in \
      x86_64)  lg_arch=x86_64 ;; \
      aarch64) lg_arch=arm64 ;; \
      *) echo "unsupported architecture: $arch" >&2; exit 1 ;; \
    esac \
 && curl -fsSL -o /tmp/lazygit.tar.gz \
      "https://github.com/jesseduffield/lazygit/releases/download/v${LAZYGIT_VERSION}/lazygit_${LAZYGIT_VERSION}_linux_${lg_arch}.tar.gz" \
 && tar -C /tmp -xzf /tmp/lazygit.tar.gz lazygit \
 && install -m755 /tmp/lazygit /usr/local/bin/lazygit \
 && rm /tmp/lazygit.tar.gz /tmp/lazygit \
 && lazygit --version

# workmux runs one agent per git worktree in its own tmux window. Verified
# against the checksum published beside the archive.
RUN arch="$(uname -m)" \
 && case "$arch" in \
      x86_64)  wm_arch=amd64 ;; \
      aarch64) wm_arch=arm64 ;; \
      *) echo "unsupported architecture: $arch" >&2; exit 1 ;; \
    esac \
 && base="https://github.com/raine/workmux/releases/download/${WORKMUX_VERSION}/workmux-linux-${wm_arch}" \
 && curl -fsSL -o /tmp/workmux.tar.gz "${base}.tar.gz" \
 && curl -fsSL -o /tmp/workmux.sha256 "${base}.sha256" \
 && echo "$(cut -d' ' -f1 /tmp/workmux.sha256)  /tmp/workmux.tar.gz" | sha256sum -c - \
 && tar -C /tmp -xzf /tmp/workmux.tar.gz \
 && install -m755 /tmp/workmux /usr/local/bin/workmux \
 && rm /tmp/workmux.tar.gz /tmp/workmux.sha256 /tmp/workmux \
 && workmux --version

# gh, so the agent can open pull requests and read issues without a browser: a
# cell cannot open one on the host, so GITHUB_TOKEN from cell.yaml is how it
# authenticates. Verified against the checksums published beside the archive.
RUN arch="$(uname -m)" \
 && case "$arch" in \
      x86_64)  gh_arch=amd64 ;; \
      aarch64) gh_arch=arm64 ;; \
      *) echo "unsupported architecture: $arch" >&2; exit 1 ;; \
    esac \
 && base="https://github.com/cli/cli/releases/download/v${GH_VERSION}" \
 && curl -fsSL -o /tmp/gh.tar.gz "${base}/gh_${GH_VERSION}_linux_${gh_arch}.tar.gz" \
 && curl -fsSL -o /tmp/gh.sha256 "${base}/gh_${GH_VERSION}_checksums.txt" \
 && echo "$(grep "gh_${GH_VERSION}_linux_${gh_arch}\.tar\.gz$" /tmp/gh.sha256 | cut -d' ' -f1)  /tmp/gh.tar.gz" \
    | sha256sum -c - \
 && tar -C /tmp -xzf /tmp/gh.tar.gz \
 && install -m755 "/tmp/gh_${GH_VERSION}_linux_${gh_arch}/bin/gh" /usr/local/bin/gh \
 && rm -rf /tmp/gh.tar.gz /tmp/gh.sha256 "/tmp/gh_${GH_VERSION}_linux_${gh_arch}" \
 && gh --version

# tmux, built from source. Ubuntu ships 3.4, which does not know
# extended-keys-format; tmux stops reading a config file at the first unknown
# option, so on 3.4 everything below that line — the theme, the key bindings,
# the plugins — is silently skipped.
RUN apt-get update \
 && apt-get install -y --no-install-recommends libevent-dev libncurses-dev bison pkg-config \
 && curl -fsSL -o /tmp/tmux.tar.gz \
      "https://github.com/tmux/tmux/releases/download/${TMUX_VERSION}/tmux-${TMUX_VERSION}.tar.gz" \
 && tar -C /tmp -xzf /tmp/tmux.tar.gz \
 && cd "/tmp/tmux-${TMUX_VERSION}" \
 && ./configure \
 && make -j"$(nproc)" \
 && make install \
 && cd / \
 && rm -rf /tmp/tmux.tar.gz "/tmp/tmux-${TMUX_VERSION}" /var/lib/apt/lists/* \
 && tmux -V

# tmux is configured system-wide rather than seeded: /etc/tmux.conf is read
# before anything in the home, so a rebuilt image brings a new theme to a cell
# whose home is years old, and a ~/.tmux.conf still overrides it. The plugins
# are cloned here rather than installed by TPM on first run, so a fresh cell has
# a working status bar without pressing anything.
ENV TMUX_PLUGIN_MANAGER_PATH=/etc/tmux/plugins/

RUN mkdir -p /etc/tmux/plugins \
 && git clone --depth 1 https://github.com/tmux-plugins/tpm /etc/tmux/plugins/tpm \
 && git clone --depth 1 https://github.com/tmux-plugins/tmux-sensible /etc/tmux/plugins/tmux-sensible \
 # Pinned: the theme is the visible half of this config, and it should not
 # change because an image was rebuilt on a different day.
 && git clone --depth 1 --branch "${CATPPUCCIN_TMUX_VERSION}" https://github.com/catppuccin/tmux /etc/tmux/plugins/tmux

# tmux is the quietest of them: given a config file it cannot read, it starts
# anyway with none of this applied and reports nothing.
COPY --chmod=0644 tmux.conf /etc/tmux.conf
COPY --chmod=0755 system-stats.sh /etc/tmux/system-stats.sh

# Everything under /opt/cell-skel is copied into the cell's home the first time
# the container starts, and only where nothing is there already.
COPY skel/ /opt/cell-skel/
COPY cell-init /usr/local/bin/cell-init
RUN chmod 755 /usr/local/bin/cell-init /opt/cell-skel/.claude/statusline-command.sh

# LazyVim, its plugins and its treesitter parsers are installed here rather than
# on first start: a build is the one place with time to spend, and it is what
# makes opening nvim in a fresh cell instant. HOME points at the skel so that
# both the config and the state it produces are seeded together.
#
# TSInstall is asynchronous and headless nvim would exit out from under it, so
# the second run waits for the parsers to appear rather than for a fixed number
# of seconds. The list above installs a few more than the 20 it waits for —
# some of its entries share a parser — and the count is checked again
# afterwards: a wait that timed out leaves nvim quitting either way, and only
# the test can tell the difference.
RUN git clone --depth 1 https://github.com/LazyVim/starter /opt/cell-skel/.config/nvim \
 && rm -rf /opt/cell-skel/.config/nvim/.git \
 && HOME=/opt/cell-skel timeout 900 nvim --headless "+Lazy! sync" +qa \
 && HOME=/opt/cell-skel timeout 900 nvim --headless \
      "+TSInstall bash c diff html javascript jsdoc json lua luadoc luap markdown markdown_inline printf python query regex toml tsx typescript vim vimdoc xml yaml" \
      "+lua vim.wait(600000, function() return #vim.fn.glob(vim.fn.stdpath('data') .. '/**/parser/*.so', true, true) >= 20 end, 2000) vim.cmd('qa!')" \
 && test "$(find /opt/cell-skel/.local/share/nvim -type f \( -name '*.so' -o -name '*-parser' \) | wc -l)" -ge 20 \
 && rm -rf /opt/cell-skel/.cache /opt/cell-skel/.local/state/nvim
