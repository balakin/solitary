#!/bin/sh
# Seed the cell's home from /opt/cell-skel.
#
# The home is a directory on the machine, mounted over /home/cell when the
# container starts: it outlives every container the cell ever runs, and it is
# empty the first time. So the image ships its dotfiles here instead, and this
# merges in whatever is missing — an edit you make inside the cell is never
# overwritten by a rebuilt image, and a file added to the skel later still
# arrives.
set -eu

SKEL=/opt/cell-skel

[ -d "$SKEL" ] || exit 0

# --skip-old-files is what makes this safe to run at every start: it unpacks
# what is not there and leaves everything else exactly as it is. tar rather
# than cp because cp's equivalent flag warns that it is going away.
tar -C "$SKEL" -cf - . | tar -C "$HOME" -xf - --skip-old-files

echo "cell-init: $HOME seeded from $SKEL"

# code-server's config, holding a random password the editor's login page asks
# for. Written once and kept in the home, so the password survives the
# container being replaced. Never turned off because the editor is only
# forwarded to the host's localhost: anything on the host can open localhost,
# and the editor is a shell in the cell.
config="$HOME/.config/code-server/config.yaml"
mkdir -p "$(dirname "$config")"
node -e '
const fs = require("node:fs");
const crypto = require("node:crypto");
const password = crypto.randomBytes(24).toString("base64url");
try {
  fs.writeFileSync(process.argv[1], `auth: password\npassword: ${password}\n`, { flag: "wx", mode: 0o600 });
} catch (error) {
  if (error.code !== "EEXIST") throw error;
}
if (!/^password: \S+$/m.test(fs.readFileSync(process.argv[1], "utf8"))) throw new Error("the editor has no password");
fs.chmodSync(process.argv[1], 0o600);
' "$config"
