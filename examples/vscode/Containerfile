# The toolset for the vscode cell. The VM around it is the boundary; this is
# replaceable tooling, and nothing here holds a credential.
#
# Nothing here is pinned. Every build takes the newest of each — the newest
# Ubuntu LTS, Node's newest LTS line, the latest nvm, gh and code-server — so a
# cell is brought up to date by rebuilding it, never by editing this file. Each
# step proves its tool runs before the build moves on, so an upstream release
# that breaks one fails the build, and the image you already have is kept.
FROM docker.io/library/ubuntu:latest

# GitHub CLI's apt repository is signed by this key, as cli.github.com's own
# install page lists it. It is the one thing written down here: a release
# changes nothing below, and a new key is a change worth noticing, so a
# keyring without it fails the build rather than being trusted because it
# arrived over HTTPS.
ARG GH_KEY_FINGERPRINT=7F38BBB59D064DBCB3D84D725612B36462313325

ENV DEBIAN_FRONTEND=noninteractive
ENV NVM_DIR=/opt/nvm
# /opt/nvm/current is a symlink this file creates. It keeps node on PATH for
# `solitary exec` and for the editor's integrated terminal, neither of which
# sources nvm's shell function.
ENV PATH=/opt/nvm/current/bin:/usr/local/bin:$PATH

# Nothing in here updates itself. The container is started over from this image
# every time the machine boots, so an update an agent downloads into it is gone
# by the next one and fetched again after it — and an update that is not in the
# image is one nobody chose. Tools are updated by rebuilding instead:
# `solitary up --rebuild`, or b in the dashboard, builds this file again without
# a cache, so what is pinned above stays pinned and what is not comes in at its
# latest — which here is all of it. gh and npm only announce updates, but there
# is nothing they could announce that the cell can act on.
ENV DISABLE_AUTOUPDATER=1 \
    GH_NO_UPDATE_NOTIFIER=1 \
    NPM_CONFIG_UPDATE_NOTIFIER=false

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      bash-completion \
      build-essential \
      ca-certificates \
      curl \
      git \
      gnupg \
      jq \
      less \
      nano \
      ripgrep \
      unzip \
 && rm -rf /var/lib/apt/lists/*

# Prints the tag of a GitHub repository's latest release; see the script.
COPY --chmod=0755 latest-tag /usr/local/bin/latest-tag

# nvm lives in /opt rather than in the home, because the cell's home is a
# directory on the machine that is mounted over /home/cell at start: anything
# this image writes under there would be hidden the moment the container runs.
# PROFILE=/dev/null keeps the installer from editing a shell rc that the seeded
# ~/.bashrc owns.
#
# Node is its newest LTS line. corepack left Node after 24, so it is installed
# from npm wherever Node no longer carries it.
RUN mkdir -p "$NVM_DIR" \
 && nvm_version="$(latest-tag https://github.com/nvm-sh/nvm)" \
 && curl -fsSL "https://raw.githubusercontent.com/nvm-sh/nvm/${nvm_version}/install.sh" \
    | PROFILE=/dev/null bash \
 && . "$NVM_DIR/nvm.sh" \
 && nvm install --lts \
 && nvm alias default 'lts/*' \
 && ln -s "$NVM_DIR/versions/node/$(nvm version default)" "$NVM_DIR/current" \
 && { command -v corepack >/dev/null || npm install -g corepack; } \
 && corepack enable \
 && node --version

RUN npm install -g @anthropic-ai/claude-code \
 && claude --version

# gh, so the agent can open pull requests and read issues without a browser: a
# cell cannot open one on the host, so GITHUB_TOKEN from cell.yaml is how it
# authenticates. From GitHub's own apt repository, so apt verifies every
# package against GitHub's signing key — once the keyring is shown to hold the
# key named at the top of this file.
RUN keyring=/etc/apt/keyrings/githubcli-archive-keyring.gpg \
 && mkdir -p -m 755 /etc/apt/keyrings \
 && curl -fsSL -o "$keyring" https://cli.github.com/packages/githubcli-archive-keyring.gpg \
 && chmod 644 "$keyring" \
 && if ! gpg --show-keys --with-colons "$keyring" | grep -q "^fpr:*${GH_KEY_FINGERPRINT}:"; then \
      echo "GitHub CLI's keyring no longer holds ${GH_KEY_FINGERPRINT}; check cli.github.com and update GH_KEY_FINGERPRINT" >&2; \
      exit 1; \
    fi \
 && echo "deb [arch=$(dpkg --print-architecture) signed-by=$keyring] https://cli.github.com/packages stable main" \
    > /etc/apt/sources.list.d/github-cli.list \
 && apt-get update \
 && apt-get install -y --no-install-recommends gh \
 && rm -rf /var/lib/apt/lists/* \
 && gh --version

# code-server, Coder's build of VS Code for the browser, at its latest release.
# Its releases publish no checksums, so HTTPS from GitHub is all that vouches
# for the archive.
RUN arch="$(uname -m)" \
 && case "$arch" in \
      x86_64)  cs_arch=amd64 ;; \
      aarch64) cs_arch=arm64 ;; \
      *) echo "unsupported architecture: $arch" >&2; exit 1 ;; \
    esac \
 && tag="$(latest-tag https://github.com/coder/code-server)" \
 && version="${tag#v}" \
 && curl -fsSL -o /tmp/code-server.tar.gz \
      "https://github.com/coder/code-server/releases/download/${tag}/code-server-${version}-linux-${cs_arch}.tar.gz" \
 && tar -C /opt -xzf /tmp/code-server.tar.gz \
 && mv "/opt/code-server-${version}-linux-${cs_arch}" /opt/code-server \
 && ln -s /opt/code-server/bin/code-server /usr/local/bin/code-server \
 && rm /tmp/code-server.tar.gz \
 && code-server --version

# Extensions are installed into the skel rather than into /opt, so they are
# seeded into the cell's home alongside anything you install later from inside
# the editor — and survive the container being replaced.
#
# code-server's marketplace is Open VSX, where these ids are case-sensitive.
# They take the current version at build time, like everything else here.
#
# Claude Code's own extension is here alongside the CLI: it drives the same
# agent from inside the editor. GitHub's themes are here because a theme is
# the one setting nobody wants to pick twice, and the seeded settings name one
# of them.
RUN for ext in \
      Anthropic.claude-code \
      dbaeumer.vscode-eslint \
      esbenp.prettier-vscode \
      bradlc.vscode-tailwindcss \
      EditorConfig.EditorConfig \
      oxc.oxc-vscode \
      astro-build.astro-vscode \
      GitHub.github-vscode-theme; do \
      code-server \
        --extensions-dir /opt/cell-skel/.local/share/code-server/extensions \
        --install-extension "$ext" || exit 1; \
    done

# Everything under /opt/cell-skel is copied into the cell's home the first time
# the container starts, and only where nothing is there already.
COPY skel/ /opt/cell-skel/
COPY cell-init /usr/local/bin/cell-init
COPY seed-extensions /usr/local/bin/seed-extensions
COPY editor-url /usr/local/bin/editor-url
RUN chmod 755 /usr/local/bin/cell-init /usr/local/bin/seed-extensions \
    /usr/local/bin/editor-url
