# The toolset for the vscode cell. The VM around it is the boundary; this is
# replaceable tooling, so everything here is installed from a pinned version and
# nothing here holds a credential.
FROM docker.io/library/ubuntu:24.04

# The versions this cell pins. Nothing else in the repository names them.
ARG NODE_VERSION=24.20.0
ARG NVM_VERSION=v0.40.7
ARG OPENVSCODE_VERSION=1.109.5
ARG GH_VERSION=2.98.0

ENV DEBIAN_FRONTEND=noninteractive
ENV NVM_DIR=/opt/nvm
# /opt/nvm/current is a symlink this file creates. It keeps node on PATH for
# `solitary exec` and for the editor's integrated terminal, neither of which
# sources nvm's shell function.
ENV PATH=/opt/nvm/current/bin:/usr/local/bin:$PATH

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      bash-completion \
      build-essential \
      ca-certificates \
      curl \
      git \
      jq \
      less \
      nano \
      ripgrep \
      unzip \
 && rm -rf /var/lib/apt/lists/*

# nvm lives in /opt rather than in the home, because the cell's home is a
# directory on the machine that is mounted over /home/cell at start: anything
# this image writes under there would be hidden the moment the container runs.
# PROFILE=/dev/null keeps the installer from editing a shell rc that the seeded
# ~/.bashrc owns.
RUN mkdir -p "$NVM_DIR" \
 && curl -fsSL "https://raw.githubusercontent.com/nvm-sh/nvm/${NVM_VERSION}/install.sh" \
    | PROFILE=/dev/null bash \
 && . "$NVM_DIR/nvm.sh" \
 && nvm install "$NODE_VERSION" \
 && nvm alias default "$NODE_VERSION" \
 && ln -s "$NVM_DIR/versions/node/v${NODE_VERSION}" "$NVM_DIR/current" \
 && corepack enable \
 && node --version

RUN npm install -g @anthropic-ai/claude-code \
 && claude --version

# gh, so the agent can open pull requests and read issues without a browser: a
# cell cannot open one on the host, so GITHUB_TOKEN from cell.yaml is how it
# authenticates. Verified against the checksums published beside the archive.
RUN arch="$(uname -m)" \
 && case "$arch" in \
      x86_64)  gh_arch=amd64 ;; \
      aarch64) gh_arch=arm64 ;; \
      *) echo "unsupported architecture: $arch" >&2; exit 1 ;; \
    esac \
 && base="https://github.com/cli/cli/releases/download/v${GH_VERSION}" \
 && curl -fsSL -o /tmp/gh.tar.gz "${base}/gh_${GH_VERSION}_linux_${gh_arch}.tar.gz" \
 && curl -fsSL -o /tmp/gh.sha256 "${base}/gh_${GH_VERSION}_checksums.txt" \
 && echo "$(grep "gh_${GH_VERSION}_linux_${gh_arch}\.tar\.gz$" /tmp/gh.sha256 | cut -d' ' -f1)  /tmp/gh.tar.gz" \
    | sha256sum -c - \
 && tar -C /tmp -xzf /tmp/gh.tar.gz \
 && install -m755 "/tmp/gh_${GH_VERSION}_linux_${gh_arch}/bin/gh" /usr/local/bin/gh \
 && rm -rf /tmp/gh.tar.gz /tmp/gh.sha256 "/tmp/gh_${GH_VERSION}_linux_${gh_arch}" \
 && gh --version

RUN arch="$(uname -m)" \
 && case "$arch" in \
      x86_64)  vs_arch=x64 ;; \
      aarch64) vs_arch=arm64 ;; \
      *) echo "unsupported architecture: $arch" >&2; exit 1 ;; \
    esac \
 && curl -fsSL -o /tmp/openvscode.tar.gz \
      "https://github.com/gitpod-io/openvscode-server/releases/download/openvscode-server-v${OPENVSCODE_VERSION}/openvscode-server-v${OPENVSCODE_VERSION}-linux-${vs_arch}.tar.gz" \
 && tar -C /opt -xzf /tmp/openvscode.tar.gz \
 && mv "/opt/openvscode-server-v${OPENVSCODE_VERSION}-linux-${vs_arch}" /opt/openvscode-server \
 && rm /tmp/openvscode.tar.gz

# The editor's defaults.
#
# They cannot be shipped as a settings file: the web workbench keeps its user
# data in the viewer's browser (IndexedDB, per origin), not in --user-data-dir,
# and openvscode-server has no flag for defaults — product.overrides.json is
# read only by a dev build. What upstream does define is configurationDefaults,
# one of the options the page hands to create(), and nothing sets it. So this
# does, in the one call that builds the workbench.
#
# Defaults, not settings: anything the viewer changes in the editor is stored in
# their browser and still wins. The count check pins this to OPENVSCODE_VERSION
# — a bundle that no longer holds exactly one such call fails the build here
# rather than quietly dropping the defaults.
COPY editor-defaults.json /opt/editor-defaults.json
RUN set -eu; \
    bootstrap=/opt/openvscode-server/out/vs/code/browser/workbench/workbench.js; \
    test "$(grep -c 'document\.body,{' "$bootstrap")" = 1; \
    defaults="$(jq -c . /opt/editor-defaults.json)"; \
    sed -i "s|document\.body,{|document.body,{configurationDefaults:$defaults,|" "$bootstrap"; \
    node --check "$bootstrap"

# Extensions are installed into the skel rather than into /opt, so they are
# seeded into the cell's home alongside anything you install later from inside
# the editor — and survive the container being replaced.
#
# openvscode-server's marketplace is Open VSX, where these ids are
# case-sensitive. Deliberately unpinned: --install-extension takes the current
# version at build time. Append @<version> to pin one.
#
# Claude Code's own extension is here alongside the CLI: it drives the same
# agent from inside the editor. GitHub's themes are here because a theme is
# the one setting nobody wants to pick twice, and the seeded settings name one
# of them.
RUN for ext in \
      Anthropic.claude-code \
      dbaeumer.vscode-eslint \
      esbenp.prettier-vscode \
      bradlc.vscode-tailwindcss \
      EditorConfig.EditorConfig \
      oxc.oxc-vscode \
      astro-build.astro-vscode \
      GitHub.github-vscode-theme; do \
      /opt/openvscode-server/bin/openvscode-server \
        --extensions-dir /opt/cell-skel/.openvscode-server/extensions \
        --install-extension "$ext" || exit 1; \
    done

# Everything under /opt/cell-skel is copied into the cell's home the first time
# the container starts, and only where nothing is there already.
COPY skel/ /opt/cell-skel/
COPY cell-init /usr/local/bin/cell-init
COPY seed-extensions /usr/local/bin/seed-extensions
RUN chmod 755 /usr/local/bin/cell-init /usr/local/bin/seed-extensions
