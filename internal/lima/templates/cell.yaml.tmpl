### Lima machine definition for a solitary cell.
###
### Rendered from this template by internal/lima; not written by users.

minimumLimaVersion: 2.0.0

base:
  - template:_images/{{ .VM.Base }}

cpus: {{ .VM.CPUs }}
memory: "{{ .VM.Memory }}"
disk: "{{ .VM.Disk }}"

# Load-bearing, not stylistic. A cell exists so that code an agent wrote is
# never interpreted by a process on the host; a mount here would hand it a
# path back to files the host executes (git hooks, package scripts, .envrc).
# Do not add mounts.
mounts: []

# Host proxy configuration can name internal hosts and carry credentials.
propagateProxyEnv: false

provision:
  - mode: system
    script: |
      #!/bin/bash
      set -eux -o pipefail
      command -v podman >/dev/null 2>&1 && exit 0
      export DEBIAN_FRONTEND=noninteractive
      apt-get update
      apt-get install -y podman uidmap slirp4netns fuse-overlayfs
{{- if .VM.Provision }}

  - mode: system
    script: |
      #!/bin/bash
      set -eux -o pipefail
{{ .VM.Provision | indent 6 }}
{{- end }}
{{- if .Network.Restricted }}

  # network.allow was set, so this cell reaches what it lists and nothing else.
  #
  # This runs last, after everything above has fetched what it needs, and again
  # on every boot. It is applied in the machine, where the container cannot
  # reach it: the container is rootless, so nothing inside it can load a
  # nftables rule, stop the resolver, or rewrite either one's configuration.
  #
  # Two halves that need each other. The firewall allows addresses in a set;
  # the resolver is the only thing that adds to it, and only for the names
  # listed here. So a name resolves and is reachable, or does neither — and a
  # site changing its addresses stays reachable without anyone editing a rule.
  - mode: system
    script: |
      #!/bin/bash
      set -eux -o pipefail
      export DEBIAN_FRONTEND=noninteractive
      command -v nft >/dev/null 2>&1 || apt-get install -y nftables
      command -v dnsmasq >/dev/null 2>&1 || apt-get install -y dnsmasq

      resolvers="{{ join .Network.ResolverAddresses " " }}"
{{- if .Network.UsesHostResolver }}

      # The machine's own resolver, discovered rather than configured: on a
      # network whose names only its resolver knows — a corporate one, a split
      # horizon, anything behind a proxy that intercepts DNS — a public
      # resolver answers with the wrong address or nothing at all.
      #
      # Read from the DHCP lease, which survives this script disabling
      # systemd-resolved and replacing resolv.conf, so it still works on the
      # boots after the first.
      host_dns=$(sed -n 's/^DNS=//p' /run/systemd/netif/leases/* 2>/dev/null | tr ' ' '\n' | grep -v '^127\.' | head -n 1 || true)
      if [ -z "$host_dns" ]; then
        echo >&2 "solitary: could not find the resolver this machine was given"
        exit 1
      fi
      resolvers="$resolvers $host_dns"
{{- end }}

      # The resolver answers for the allowed names and nothing else: an
      # unlisted name gets NXDOMAIN rather than an address, so a query cannot
      # carry anything out to a resolver of its own choosing either.
      cat > /etc/dnsmasq.d/solitary.conf <<'DNSMASQ'
      # Written by solitary. Edits are lost on the next boot.
      # Every question and answer is logged, which is what makes a cell's
      # traffic readable by name rather than by address.
      log-queries
      listen-address=127.0.0.1
      bind-interfaces
      no-resolv
      no-hosts
      cache-size=1000
      local=/#/
      # A machine has no IPv6 route, so an AAAA answer only sends a client
      # down a path that cannot work — and it would need a second set the
      # resolver has to keep in step with this one.
      filter-AAAA
      DNSMASQ
      for domain in {{ join .Network.Domains " " }}; do
        for resolver in $resolvers; do
          echo "server=/$domain/$resolver"
        done
        echo "nftset=/$domain/inet#solitary#allowed4"
      done >> /etc/dnsmasq.d/solitary.conf

      # Nothing resolves through systemd-resolved any more, and left running it
      # retries an upstream it can no longer reach once a second, filling the
      # log this cell's traffic is read from.
      systemctl disable --now systemd-resolved 2>/dev/null || true

      # Replaced rather than written into. On Ubuntu this path is a symlink
      # into systemd-resolved's runtime directory, which the line above just
      # removed, so writing through it lands nowhere — and with set -e that
      # takes the rest of this script, and the resolver's own configuration,
      # down with it. The immutable flag is cleared first for the same reason:
      # it is set below, and a later boot must still be able to replace this.
      chattr -i /etc/resolv.conf 2>/dev/null || true
      rm -f /etc/resolv.conf
      cat > /etc/resolv.conf <<'RESOLV'
      # Written by solitary. The cell resolves through its own resolver only.
      nameserver 127.0.0.1
      options edns0
      RESOLV
      chattr +i /etc/resolv.conf 2>/dev/null || true

      cat > /etc/nftables.conf <<'NFT'
      #!/usr/sbin/nft -f
      # Written by solitary. Edits are lost on the next boot.
      flush ruleset

      table inet solitary {
        # Filled in by the resolver as it answers for the allowed names.
        # Without an expiry: a program that resolves a name once and keeps the
        # address — a connection pool, an NTP client — would otherwise work at
        # first and be refused later, which is a worse thing to debug than the
        # addresses of an allowed name staying reachable while the cell runs.
        set allowed4 { type ipv4_addr; }

        # Addresses the cell was configured with directly.
        set static4 { type ipv4_addr; flags interval;{{ if .Network.Addresses }}
          elements = { {{ join .Network.Addresses ", " }} }{{ end }}
        }

        # The resolver's own upstream. Nothing else may reach it, so a
        # process in the cell cannot ask a question this resolver refuses.
        set upstream { type ipv4_addr;{{ if .Network.ResolverAddresses }}
          elements = { {{ join .Network.ResolverAddresses ", " }} }{{ end }}
        }

        chain output {
          type filter hook output priority filter; policy drop;

          ct state established,related accept
          oifname "lo" accept

          # Answers to whatever reached the cell from the host.
          ct state new tcp sport 22 accept

          meta skuid dnsmasq ip daddr @upstream udp dport 53 accept
          meta skuid dnsmasq ip daddr @upstream tcp dport 53 accept
          ip daddr 127.0.0.1 udp dport 53 accept
          ip daddr 127.0.0.1 tcp dport 53 accept

          # Keeping the address the machine was given.
          udp dport { 67, 68 } accept

          ip daddr @allowed4 accept
          ip daddr @static4 accept

          # The machine has no IPv6 route, so its neighbour and router
          # discovery goes nowhere. Dropped without a line each time.
          ip6 daddr ff00::/8 drop

          # Everything else, the host and the local network included. Logged
          # first: a refusal nobody can see is indistinguishable from a bug,
          # and what a cell tried to reach is worth knowing. Rate-limited so
          # that a program retrying in a loop cannot fill the machine's disk.
          limit rate 10/second burst 20 packets log prefix "solitary-deny " level info
          counter drop
        }
      }
      NFT

      systemctl enable --now nftables
      nft -f /etc/nftables.conf

      # Whatever was discovered above is allowed the same way the configured
      # ones are: to the resolver, on port 53, and to nothing else.
      for resolver in $resolvers; do
        nft add element inet solitary upstream "{ $resolver }"
      done
      systemctl enable dnsmasq
      systemctl restart dnsmasq

      # Anything that resolved a name before this script ran holds an address
      # the firewall has just forgotten — the ruleset is loaded from scratch,
      # and only the resolver refills it. Restarted so they ask again, under
      # the allow list this time.
      systemctl try-restart chrony 2>/dev/null || true
{{- end }}

probes:
  - script: |
      #!/bin/bash
      set -eux -o pipefail
      if ! timeout 30s bash -c "until command -v podman >/dev/null 2>&1; do sleep 3; done"; then
        echo >&2 "podman is not installed yet"
        exit 1
      fi
    hint: See "/var/log/cloud-init-output.log" in the guest

{{- if .Ports }}

# ports: was set on the cell, so the default catch-all is replaced by an
# explicit allow list.
#
# Every rule appears twice, once for each address a server binds. A rule with no
# guestIP matches only a listener on 127.0.0.1, and Lima's own fallback rule
# then forwards everything bound to 0.0.0.0 — which is what a dev server binds,
# so a deny rule written once denies nothing at all. Rules are checked in order
# and the first match wins, so the allows come before the denials.
#
# hostIP is left alone throughout: forwarded ports reach this host's localhost
# and nowhere else.
portForwards:
{{- range .Ports }}
  - guestIP: "0.0.0.0"
    guestPort: {{ . }}
    hostPort: {{ . }}
  - guestPort: {{ . }}
    hostPort: {{ . }}
{{- end }}
  - guestIP: "0.0.0.0"
    guestPortRange: [1, 65535]
    proto: any
    ignore: true
  - guestPortRange: [1, 65535]
    proto: any
    ignore: true
{{- end }}
