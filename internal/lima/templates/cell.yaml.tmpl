### Lima machine definition for a solitary cell.
###
### Rendered from this template by internal/lima; not written by users.

minimumLimaVersion: 2.0.0

base:
  - template:_images/{{ .VM.Base }}

cpus: {{ .VM.CPUs }}
memory: "{{ .VM.Memory }}"
disk: "{{ .VM.Disk }}"

# Load-bearing, not stylistic. A cell exists so that code an agent wrote is
# never interpreted by a process on the host; a mount here would hand it a
# path back to files the host executes (git hooks, package scripts, .envrc).
# Do not add mounts.
mounts: []

# Host proxy configuration can name internal hosts and carry credentials.
propagateProxyEnv: false

provision:
  - mode: system
    script: |
      #!/bin/bash
      set -eux -o pipefail
      command -v podman >/dev/null 2>&1 && exit 0
      export DEBIAN_FRONTEND=noninteractive
      apt-get update
      apt-get install -y podman uidmap slirp4netns fuse-overlayfs
{{- if .VM.Provision }}

  - mode: system
    script: |
      #!/bin/bash
      set -eux -o pipefail
{{ .VM.Provision | indent 6 }}
{{- end }}
{{- if .Network.Tunnel }}

  # network.vpn was set, so everything this cell reaches leaves through a
  # WireGuard tunnel.
  #
  # Only what the machine needs to bring the tunnel up is here. The
  # configuration itself is not: it holds a private key, and this definition is
  # kept on disk for as long as the machine exists and is handed to the guest
  # through cloud-init. solitary places the file separately, into the machine,
  # once it is running.
  #
  # {{ .Network.Tunnel.Digest }}
  #
  # That digest is what makes replacing the configuration a change to the cell:
  # nothing else here would differ, and the machine would keep dialling the old
  # peer.
  - mode: system
    script: |
      #!/bin/bash
      set -eux -o pipefail
      export DEBIAN_FRONTEND=noninteractive
      # The tools only. The kernel this machine boots has WireGuard in it
      # already, and the metapackage would build a module it does not need.
      command -v wg-quick >/dev/null 2>&1 || apt-get install -y wireguard-tools

      # The tunnel comes up after the two things it depends on: the resolver
      # that turns its peer into an address, and the firewall that lets it
      # reach it. Ordering only, not a hard requirement — an unrestricted cell
      # runs neither.
      mkdir -p /etc/systemd/system/wg-quick@{{ vpnInterface }}.service.d
      cat > /etc/systemd/system/wg-quick@{{ vpnInterface }}.service.d/solitary.conf <<'UNIT'
      # Written by solitary. Edits are lost on the next boot.
      [Unit]
      After=dnsmasq.service nftables.service
      UNIT
      systemctl daemon-reload
{{- else }}

  # network.vpn is not set, so this cell sends its traffic the way it came.
  #
  # A machine keeps its disk across a change to the cell that describes it, and
  # a tunnel installed by an earlier definition would otherwise still be
  # enabled: the interface would come up at every boot from a configuration
  # nothing here mentions any more. So the machine is put back the way an
  # untunnelled one starts out, rather than left carrying a tunnel the cell no
  # longer asks for.
  - mode: system
    script: |
      #!/bin/bash
      set -eux -o pipefail

      # Nothing to undo on a machine that never had a tunnel, which is the
      # ordinary case: this runs on every boot of every untunnelled cell.
      if [ ! -e {{ vpnConfig }} ]; then
        exit 0
      fi

      systemctl disable --now wg-quick@{{ vpnInterface }} 2>/dev/null || true
      # The private key goes with it. A configuration the cell no longer names
      # has no reason to stay on a disk.
      rm -f {{ vpnConfig }}
      rm -f /etc/systemd/system/wg-quick@{{ vpnInterface }}.service.d/solitary.conf
      rmdir /etc/systemd/system/wg-quick@{{ vpnInterface }}.service.d 2>/dev/null || true
      systemctl daemon-reload
{{- end }}
{{- if .Network.Restricted }}

  # network.allow was set, so this cell reaches what it lists and nothing else.
  #
  # This runs last, after everything above has fetched what it needs, and again
  # on every boot. It is applied in the machine, where the container cannot
  # reach it: the container is rootless, so nothing inside it can load a
  # nftables rule, stop the resolver, or rewrite either one's configuration.
  #
  # Two halves that need each other. The firewall allows addresses in a set;
  # the resolver is the only thing that adds to it, and only for the names
  # listed here. So a name resolves and is reachable, or does neither — and a
  # site changing its addresses stays reachable without anyone editing a rule.
  - mode: system
    script: |
      #!/bin/bash
      set -eux -o pipefail
      export DEBIAN_FRONTEND=noninteractive
      command -v nft >/dev/null 2>&1 || apt-get install -y nftables
      command -v dnsmasq >/dev/null 2>&1 || apt-get install -y dnsmasq

      resolvers="{{ join .Network.ResolverAddresses " " }}"
{{- if .Network.UsesHostResolver }}

      # The machine's own resolver, discovered rather than configured: on a
      # network whose names only its resolver knows — a corporate one, a split
      # horizon, anything behind a proxy that intercepts DNS — a public
      # resolver answers with the wrong address or nothing at all.
      #
      # Read from the DHCP lease, which survives this script disabling
      # systemd-resolved and replacing resolv.conf, so it still works on the
      # boots after the first.
      host_dns=$(sed -n 's/^DNS=//p' /run/systemd/netif/leases/* 2>/dev/null | tr ' ' '\n' | grep -v '^127\.' | head -n 1 || true)
      if [ -z "$host_dns" ]; then
        echo >&2 "solitary: could not find the resolver this machine was given"
        exit 1
      fi
      resolvers="$resolvers $host_dns"
{{- end }}

      # The resolver answers for the allowed names and nothing else: an
      # unlisted name gets NXDOMAIN rather than an address, so a query cannot
      # carry anything out to a resolver of its own choosing either.
      cat > /etc/dnsmasq.d/solitary.conf <<'DNSMASQ'
      # Written by solitary. Edits are lost on the next boot.
      # Every question and answer is logged, which is what makes a cell's
      # traffic readable by name rather than by address.
      log-queries
      listen-address=127.0.0.1
      bind-interfaces
      no-resolv
      no-hosts
      cache-size=1000
      local=/#/
      # A machine has no IPv6 route, so an AAAA answer only sends a client
      # down a path that cannot work — and it would need a second set the
      # resolver has to keep in step with this one.
      filter-AAAA
      DNSMASQ
      for domain in {{ join .Network.Domains " " }}; do
        for resolver in $resolvers; do
          echo "server=/$domain/$resolver"
        done
        echo "nftset=/$domain/inet#solitary#allowed4"
      done >> /etc/dnsmasq.d/solitary.conf
{{- if and .Network.Tunnel (not .Network.Tunnel.EndpointIsAddress) }}

      # The tunnel's own peer, resolved like any other allowed name but into a
      # set of its own: everything else is reachable only through the tunnel,
      # and the peer is what there is no tunnel without.
      for resolver in $resolvers; do
        echo "server=/{{ .Network.Tunnel.EndpointHost }}/$resolver"
      done >> /etc/dnsmasq.d/solitary.conf
      echo "nftset=/{{ .Network.Tunnel.EndpointHost }}/inet#solitary#vpn4" >> /etc/dnsmasq.d/solitary.conf
{{- end }}

      # Nothing resolves through systemd-resolved any more, and left running it
      # retries an upstream it can no longer reach once a second, filling the
      # log this cell's traffic is read from.
      systemctl disable --now systemd-resolved 2>/dev/null || true

      # Replaced rather than written into. On Ubuntu this path is a symlink
      # into systemd-resolved's runtime directory, which the line above just
      # removed, so writing through it lands nowhere — and with set -e that
      # takes the rest of this script, and the resolver's own configuration,
      # down with it. The immutable flag is cleared first for the same reason:
      # it is set below, and a later boot must still be able to replace this.
      chattr -i /etc/resolv.conf 2>/dev/null || true
      rm -f /etc/resolv.conf
      cat > /etc/resolv.conf <<'RESOLV'
      # Written by solitary. The cell resolves through its own resolver only.
      nameserver 127.0.0.1
      options edns0
      RESOLV
      chattr +i /etc/resolv.conf 2>/dev/null || true

      cat > /etc/nftables.conf <<'NFT'
      #!/usr/sbin/nft -f
      # Written by solitary. Edits are lost on the next boot.
      #
      # Only this table is replaced, never the whole ruleset: wg-quick installs
      # a table of its own when it routes everything, and flushing that from
      # under it would leave the tunnel up with its own protections gone.
      table inet solitary {}
      delete table inet solitary

      table inet solitary {
        # Filled in by the resolver as it answers for the allowed names.
        # Without an expiry: a program that resolves a name once and keeps the
        # address — a connection pool, an NTP client — would otherwise work at
        # first and be refused later, which is a worse thing to debug than the
        # addresses of an allowed name staying reachable while the cell runs.
        set allowed4 { type ipv4_addr; }

        # Addresses the cell was configured with directly.
        set static4 { type ipv4_addr; flags interval;{{ if .Network.Addresses }}
          elements = { {{ join .Network.Addresses ", " }} }{{ end }}
        }

        # The resolver's own upstream. Nothing else may reach it, so a
        # process in the cell cannot ask a question this resolver refuses.
        set upstream { type ipv4_addr;{{ if .Network.ResolverAddresses }}
          elements = { {{ join .Network.ResolverAddresses ", " }} }{{ end }}
        }
{{- if .Network.Tunnel }}

        # The tunnel's peer. Its own set, because it is the one thing that
        # has to be reachable without the tunnel.
        set vpn4 { type ipv4_addr;{{ if .Network.Tunnel.EndpointIsAddress }}
          elements = { {{ .Network.Tunnel.EndpointHost }} }{{ end }}
        }
{{- end }}

        chain output {
          type filter hook output priority filter; policy drop;

          ct state established,related accept
          oifname "lo" accept

          # Answers to whatever reached the cell from the host.
          ct state new tcp sport 22 accept

{{ if .Network.Tunnel }}          # Not limited to the tunnel, unlike everything below: the peer's own
          # name has to be resolved before there is a tunnel to resolve it
          # through. So while the tunnel is down these queries — and nothing
          # else — still leave.
{{ end }}          meta skuid dnsmasq ip daddr @upstream udp dport 53 accept
          meta skuid dnsmasq ip daddr @upstream tcp dport 53 accept
          ip daddr 127.0.0.1 udp dport 53 accept
          ip daddr 127.0.0.1 tcp dport 53 accept

          # Keeping the address the machine was given.
          udp dport { 67, 68 } accept
{{- if .Network.Tunnel }}

          # Making the tunnel. This is the only thing the cell sends that
          # does not go through it.
          ip daddr @vpn4 udp dport {{ .Network.Tunnel.EndpointPort }} accept

          # And everything allowed is allowed through the tunnel only. This
          # is what network.vpn means: no tunnel, nothing leaves — rather
          # than the same traffic quietly going out the way it came.
          oifname "{{ vpnInterface }}" ip daddr @allowed4 accept
          oifname "{{ vpnInterface }}" ip daddr @static4 accept
{{- else }}

          ip daddr @allowed4 accept
          ip daddr @static4 accept
{{- end }}

          # The machine has no IPv6 route, so its neighbour and router
          # discovery goes nowhere. Dropped without a line each time.
          ip6 daddr ff00::/8 drop

          # Everything else, the host and the local network included. Logged
          # first: a refusal nobody can see is indistinguishable from a bug,
          # and what a cell tried to reach is worth knowing. Rate-limited so
          # that a program retrying in a loop cannot fill the machine's disk.
          limit rate 10/second burst 20 packets log prefix "solitary-deny " level info
          counter drop
        }
      }
      NFT

      systemctl enable --now nftables
      nft -f /etc/nftables.conf

      # Whatever was discovered above is allowed the same way the configured
      # ones are: to the resolver, on port 53, and to nothing else.
      for resolver in $resolvers; do
        nft add element inet solitary upstream "{ $resolver }"
      done
      systemctl enable dnsmasq
      systemctl restart dnsmasq

      # Anything that resolved a name before this script ran holds an address
      # the firewall has just forgotten — the ruleset is loaded from scratch,
      # and only the resolver refills it. Restarted so they ask again, under
      # the allow list this time.
      systemctl try-restart chrony 2>/dev/null || true
{{- else }}

  # network.allow was not set, so this cell reaches whatever the host reaches.
  #
  # The counterpart of the block above, and the reason it can be removed at all.
  # A restriction is not only a rule in a definition: applying it writes a
  # resolver configuration, a firewall and an immutable resolv.conf into the
  # machine, and those live on the machine's disk, which survives every change
  # to the cell short of destroying it. Taking network.allow out of cell.yaml
  # would otherwise leave the cell enforcing an allow list nothing describes any
  # more — reachable names that are not listed anywhere, refusals with no rule
  # behind them.
  #
  # So this undoes it, on every boot, and the guest matches the definition
  # whichever way the setting was last changed.
  - mode: system
    script: |
      #!/bin/bash
      set -eux -o pipefail

      # Nothing to undo on a machine that was never restricted, which is the
      # ordinary case: this runs on every boot of every unrestricted cell.
      if [ ! -e /etc/dnsmasq.d/solitary.conf ] && ! nft list table inet solitary >/dev/null 2>&1; then
        exit 0
      fi

      # The firewall. The table goes first so that nothing is refused while the
      # rest of this runs.
      nft delete table inet solitary 2>/dev/null || true
      if [ -e /etc/nftables.conf ] && grep -q "Written by solitary" /etc/nftables.conf; then
        rm -f /etc/nftables.conf
        # Left enabled it would fail at the next boot on the file just removed.
        systemctl disable --now nftables 2>/dev/null || true
      fi

      # The resolver. Only solitary's own configuration is removed; dnsmasq is
      # stopped because solitary is what started it.
      rm -f /etc/dnsmasq.d/solitary.conf
      systemctl disable --now dnsmasq 2>/dev/null || true

      # And resolv.conf, handed back to the resolver the image ships with. The
      # immutable flag is what the restriction used to keep anything in the
      # machine from writing over it, so it has to be cleared before the file
      # can be replaced.
      chattr -i /etc/resolv.conf 2>/dev/null || true
      rm -f /etc/resolv.conf
      systemctl enable --now systemd-resolved
      ln -sf ../run/systemd/resolve/stub-resolv.conf /etc/resolv.conf

      # Anything holding an address it resolved through the old resolver asks
      # again, the same way the restriction restarts them when it goes on.
      systemctl try-restart chrony 2>/dev/null || true
{{- end }}

probes:
  - script: |
      #!/bin/bash
      set -eux -o pipefail
      if ! timeout 30s bash -c "until command -v podman >/dev/null 2>&1; do sleep 3; done"; then
        echo >&2 "podman is not installed yet"
        exit 1
      fi
    hint: See "/var/log/cloud-init-output.log" in the guest

{{- if .Ports }}

# ports: was set on the cell, so the default catch-all is replaced by an
# explicit allow list.
#
# Every rule appears twice, once for each address a server binds. A rule with no
# guestIP matches only a listener on 127.0.0.1, and Lima's own fallback rule
# then forwards everything bound to 0.0.0.0 — which is what a dev server binds,
# so a deny rule written once denies nothing at all. Rules are checked in order
# and the first match wins, so the allows come before the denials.
#
# hostIP is left alone throughout: forwarded ports reach this host's localhost
# and nowhere else.
portForwards:
{{- range .Ports }}
  - guestIP: "0.0.0.0"
    guestPort: {{ . }}
    hostPort: {{ . }}
  - guestPort: {{ . }}
    hostPort: {{ . }}
{{- end }}
  - guestIP: "0.0.0.0"
    guestPortRange: [1, 65535]
    proto: any
    ignore: true
  - guestPortRange: [1, 65535]
    proto: any
    ignore: true
{{- end }}
